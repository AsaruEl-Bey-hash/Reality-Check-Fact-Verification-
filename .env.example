# Copy this file to `.env` and fill in real values.
# Never commit the resulting `.env` file — `.gitignore` already excludes it.

# --- Application ---
APP_NAME=Reality-Check
APP_ENV=development
APP_PORT=3000
APP_LOG_LEVEL=info

# --- Storage (verification records, sources, claims) ---
DATABASE_URL=
# Example for a SQL store:
# DATABASE_URL=postgresql://postgres@localhost:5432/realitycheck

# --- Cache / queue (optional) ---
REDIS_URL=

# --- External integrations (add as needed) ---
# API keys and endpoints for fact-checking data sources live here.
# Keep keys short-lived and scope-limited.
FACTCHECK_API_KEY=
FACTCHECK_API_BASE_URL=
