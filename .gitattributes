# Default: normalize line endings to LF
* text=auto eol=lf

# Explicitly enforced line endings
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Mark binary/asset files as binary so Git doesn't touch them
*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.woff2 binary
*.woff binary
